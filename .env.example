# MongoDB URI must include a database name. Local MongoDB or Atlas both work.
MONGODB_URI=mongodb://127.0.0.1:27017/maison_ember

# Use the exact URL serving the app; set the HTTPS domain when deploying.
BETTER_AUTH_URL=http://localhost:3000

# Generate with: openssl rand -base64 32
# Never use a shared example secret or commit .env.local.
BETTER_AUTH_SECRET=
